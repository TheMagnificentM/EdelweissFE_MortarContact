** ==============================================================================
** Control Test 01 - REFERENZ (Monolith, hex20R)
** ==============================================================================
**
** Ein verschmolzener Block 1 x 2 x 1 (y in [0,2]), KEIN Kontakt, Elementtyp C3D20R.
** Gleiches Netz wie die zwei gestapelten Bloecke (nY=2), gleiche Last.
** Liefert die FE-Referenz -> isoliert den Kontakt von der Element-Diskretisierung.
**
** Ausfuehren:  edelweissfe reference_monolith_hex20R.inp
** ------------------------------------------------------------------------------

*modelGenerator, generator=boxGen, name=gen
nX=2
nY=2
nZ=2
lX=1.0
lY=2.0
lZ=1.0
elType=C3D20R

*modelGenerator, generator=executePythonCode, name=allnodesgen
import os
import sys
sys.path.append(os.getcwd())
sys.path.append(os.path.dirname(os.getcwd()))
import contact_setup
contact_setup.add_allnodes(model)

*material, name=linearelastic, id=mat
1000.0, 0.0

*section, name=sec, material=mat, type=solid
gen_all

*job, name=selfweightmonojob, domain=3d
*solver, name=theSolver, solver=NISTParallel

*fieldOutput
>>perNode,    name=displacement, elSet=all, field=displacement, result=U
>>perNode,    name=P,            elSet=all, field=displacement, result=P
>>perNode,    name=nodal_U,      elSet=all, field=displacement, result=U, saveHistory=True, export=mono_nodal_U
>>perElement, name=stress,       elSet=all, result=stress, quadraturePoint=0:8, f(x)='np.mean(x,axis=1)'
>>perElement, name=strain,       elSet=all, result=strain, quadraturePoint=0:8, f(x)='np.mean(x,axis=1)'
>>perElement, name=stressGP,     elSet=all, result=stress, quadraturePoint=0:8, saveHistory=True, export=mono_stress_gp

*output, type=ensight, name=ensight_selfweight_monolith_hex20R
>>perNode,    fieldOutput=displacement
>>perNode,    fieldOutput=P
>>perElement, fieldOutput=stress
>>configuration, overwrite=yes

*step, solver=theSolver
maxInc=0.5, minInc=1e-3, maxNumInc=200, maxIter=25, stepLength=1
>>dirichlet, name=bot, nSet=gen_bottom, field=displacement, 2=0.0
>>dirichlet, name=lat, nSet=allnodes,   field=displacement, 1=0.0, 3=0.0
>>bodyforce, name=gravity, elSet=gen_all, forceVector='0.0, -10.0, 0.0', f(t)=t
