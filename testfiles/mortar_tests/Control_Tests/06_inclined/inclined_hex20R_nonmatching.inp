** ==============================================================================
** Control Test 06 - schiefes Interface (30 Grad, Normalen-Test)   (hex20R, nonmatching interface)
** ==============================================================================
**
** Zwei linear-elastische Einheitswuerfel, Block A (unten, y in [0,1], Slave) und
** Block B (oben, y in [1,2], Master), ueber MortarContact3D verbunden.
** Elementtyp C3D20R ; Interface nonmatching (A 2x2 gegen B 3x3).
**
** ERWARTETE LOESUNG (gesamte Geometrie um 30 Grad um z gedreht, dann axial gedrueckt):
**   Die Kontaktflaeche liegt schief -> Test der Knoten-Normalen.
**   Axialspannung entlang der (gedrehten) Achse = -10, Kontaktdruck = 10 konstant.
**   Achse a = (-sin30, cos30, 0) = (-0.5, 0.8660254, 0).
**
** Ausfuehren:  edelweissfe inclined_hex20R_nonmatching.inp
** Auswerten:   python ../evaluate.py inclined_hex20R_nonmatching.inp
** ------------------------------------------------------------------------------

*modelGenerator, generator=boxGen, name=genA
nX=2
nY=1
nZ=2
lX=1.0
lY=1.0
lZ=1.0
elType=C3D20R

*modelGenerator, generator=boxGen, name=genB
y0=1.0
nX=3
nY=1
nZ=3
lX=1.0
lY=1.0
lZ=1.0
elType=C3D20R

*modelGenerator, generator=executePythonCode, name=contactgen
import os
import sys
sys.path.append(os.getcwd())
sys.path.append(os.path.dirname(os.getcwd()))
import contact_setup
contact_setup.setup_inclined(model)

*material, name=linearelastic, id=mat
1000.0, 0.0

*section, name=secA, material=mat, type=solid
genA_all
*section, name=secB, material=mat, type=solid
genB_all

*constraint, type=mortarcontact, name=contact
nonMortarSurface=con_slave
mortarSurface=con_master
field=displacement

*job, name=inclinedjob, domain=3d
*solver, name=theSolver, solver=NISTParallel

*fieldOutput
>>perNode,    name=displacement, elSet=all, field=displacement, result=U
>>perNode,    name=P,            elSet=all, field=displacement, result=P
>>perNode,    name=nodal_U,      elSet=all, field=displacement, result=U, saveHistory=True, export=nodal_U
>>perNode,    name=RF,           nSet=genA_bottom, field=displacement, result=P, saveHistory=True, export=reaction
>>perElement, name=stress,       elSet=solids, result=stress, quadraturePoint=0:8, f(x)='np.mean(x,axis=1)'
>>perElement, name=strain,       elSet=solids, result=strain, quadraturePoint=0:8, f(x)='np.mean(x,axis=1)'
>>perElement, name=stressGP,     elSet=solids, result=stress, quadraturePoint=0:8, saveHistory=True, export=stress_gp
>>perElement, name=strainGP,     elSet=solids, result=strain, quadraturePoint=0:8, saveHistory=True, export=strain_gp
>>perNode,    name=utop,         nSet=genB_top, field=displacement, result=U, f(x)='np.mean(x[:,1])', saveHistory=True, export=utop

*output, type=ensight, name=ensight_inclined_hex20R_nonmatching
>>perNode,    fieldOutput=displacement
>>perNode,    fieldOutput=P
>>perElement, fieldOutput=stress
>>perElement, fieldOutput=strain
>>configuration, overwrite=yes

*output, type=monitor, name=myMonitor
fieldOutput=utop

*step, solver=theSolver
maxInc=0.25, minInc=1e-4, maxNumInc=400, maxIter=30, stepLength=1
>>dirichlet, name=zfix, nSet=allnodes,    field=displacement, 3=0.0
>>dirichlet, name=bot,  nSet=genA_bottom, field=displacement, 1=0.0, 2=0.0
>>dirichlet, name=top,  nSet=genB_top,    field=displacement, 1=0.01, 2=-0.0173205081, f(t)=t
