**
** --- Rechts: Kopf unten (horizontal) ---
*constraint, type=mortarcontact, name=contact_r_head_horiz
nonMortarSurface=con_conc_r_head_horiz
mortarSurface=con_stl_r_head_horiz
field=displacement
friction_coefficient=0.3   
